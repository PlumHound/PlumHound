[ "Domains", "HTMLCSV", "Domains", "MATCH (n:Domain) return n.name as Domain, n.functionallevel as FunctionalLevel, n.highvalue as HighValue, n.domain as DNS, n.distinguishedname as DN, n.domainsid as SID" ]
["Domain Trusts", "HTMLCSV", "DomainTrusts", "MATCH p=(n:Domain)-[r:TrustedBy]->(m:Domain) RETURN n.name as Domain1, r.trusttype as TrustType, r.isacl as IsACL, r.sidfiltering as SidFiltering, r.transitive as transitive,  m.name as Domain2 order by n.name, m.name"]
["Domain Controllers","HTMLCSV","DomainControllers","MATCH (c:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' RETURN c.name as Hostname, c.operatingsystem as OS, c.description as Description,toString(datetime({epochSeconds: ToInteger(coalesce(c.whencreated,0))})) as Created,c.haslaps as LAPS, c.enabled as Enabled, c.distinguishedname as DN"]
["Domain Controllers - Read Only", "HTMLCSV", "DomainControllers_ReadOnly", "MATCH (c:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-521' RETURN c.name as Hostname, c.operatingsystem as OS, c.description as Description,toString(datetime({epochSeconds: ToInteger(coalesce(c.whencreated,0))})) as Created,c.haslaps as LAPS, c.enabled as Enabled, c.distinguishedname as DN" ]
["Enterprise Admins (Direct)", "HTML", "EnterpriseAdmins.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-519' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, head(labels(m)) as type, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation,  toString(datetime({epochSeconds: ToInteger(coalesce(m.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(m.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY Name" ]
["Schema Admins (Direct)", "HTML", "SchemaAdmins.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-518' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, head(labels(m)) as type, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation,  toString(datetime({epochSeconds: ToInteger(coalesce(m.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(m.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY Name" ]
["Domain Admins (Direct)", "HTML", "DomainAdmins.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-512' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, head(labels(m)) as type, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation,  toString(datetime({epochSeconds: ToInteger(coalesce(m.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(m.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY Name" ]
["Admin Groups","HTMLCSV","AdminGroups","Match (n:Group) WHERE n.name CONTAINS \'ADMIN\' return n.name as Name, n.highvalue as HighValue, n.description as Description, n.admincount as AdminCount"]
["Admin Groups Direct Population","HTMLCSV","AdminGroupsPopulatedCount","Match (u)-[:MemberOf]->(g:Group) WHERE toUPPER (g.name) CONTAINS 'ADMIN' return g.name as Group, g.description as Description,  Count(DISTINCT(u.name)) as Members ORDER BY Members DESC"]
["Domain User Accounts", "HTMLCSV", "DomainUsers", "MATCH (n:User) RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Domain Computer Accounts", "HTMLCSV", "DomainComputers", "MATCH (n:Computer) RETURN n.name as Name, n.domain, n.enabled as Enabled,n.haslaps as LAPS, n.highvalue as HighValue,n.operatingsystem as OS,  n.description as Description, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp,n.serviceprincipalnames as SPN ORDER BY n.highvalue DESC , n.name ASC" ]
["Domain Groups", "HTMLCSV", "DomainGroups", "Match (o)-[r:Owns]->(n:Group) return n.name as Name, n.highvalue as HighValue, n.description as Description, o.name as Owner, head(Labels(o)) as OwnerType"]
["OUs By Computer Member Count","HTML","OUs_ComputerCount.html","MATCH (o:OU)-[:Contains]->(c:Computer) RETURN o.distinguishedname as DN, COUNT(c) as Computers ORDER BY COUNT(c) DESC"]
["OUs By User Member Count","HTML","OUs_UserCount.html","MATCH (o:OU)-[:Contains]->(c:User) RETURN  o.distinguishedname as DN, COUNT(c) as Users ORDER BY COUNT(c) DESC"]
["OUs By Group Member Count", "HTML", "OUs_GroupCount.html", "MATCH (o:OU)-[:Contains]->(c:Group) RETURN  o.distinguishedname as DN, COUNT(c) as Groups ORDER BY COUNT(c) DESC" ]
["Cert Publishers (Direct)", "HTML", "CertPublishers.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-517' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation"]
["DA Sessions","HTML","DA_Sessions.html","MATCH (n:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH \'-512\' MATCH p = (c:Computer)-[:HasSession]->(n) return n.name as Username, c.name as Computer"]
["EA Sessions","HTML","EA_Sessions.html","MATCH (n:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH \'-519\' MATCH p = (c:Computer)-[:HasSession]->(n) return n.name as Username, c.name as Computer"]
["User Sessions Count","HTML","UserSessionsCount.html","MATCH (n:User)-[r:HasSession]->(m:Computer) RETURN n.name, count(DISTINCT(m.name)) as SessionCount order by SessionCount desc LIMIT 100"]
["HighValue Group Members (Direct) (Limited to 1000)","HTMLCSV","Groups-HighValue-members","MATCH p=(n:User)-[r:MemberOf]->(m:Group {highvalue:true}) RETURN n.name as User, m.name as Group Limit 1000"]
["Protected Users Group (Direct)", "HTML", "ProtectedUsers.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-525' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation" ]
["Admins Without Sensitive Protection Flag", "HTMLCSV", "AdminsWithoutSensitiveFlag.html", "MATCH p=(n:User)-[r:MemberOf]->(m:Group {highvalue:true}) WHERE n.sensitive=false RETURN m.name as Group, n.name as User, n.displayname as DisplayName,n.description as Description, n.enabled as Enabled, n.pwdneverexpires as PWDNeverExpire, n.trustedtoauth as TrustedToAuth, n.unconstraineddelegation as UncDelegation LIMIT 1000" ]
["Kerberoastable Users","HTML","Kerberoastable_Users.html","MATCH (n:User) WHERE n.hasspn=true RETURN n.name as Username, n.displayname as DisplayName,n.description as Description, n.enabled as Enabled, n.pwdneverexpires as PasswordNeverExpires, n.passwordnotreqd as PasswordNotRequired, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPNs"]
["Pre-Windows 2000 Compatibility Access Direct Members", "HTMLCSV", "PreWindows2000.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid ENDS WITH 'S-1-5-32-554' RETURN n.domain as Domain, m.name as Name, m.displayname as DisplayName,m.description as Description, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation" ]
["RDPable Servers","HTML","Workstations_RDP.html","match p=(g:Group)-[:CanRDP]->(c:Computer) where  g.objectid ENDS WITH \'-513\'  AND c.operatingsystem CONTAINS \'Server\' return c.name as Computer"]
["Domain Controller Owners","HTMLCSV","DCOwners","MATCH (c1:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' WITH COLLECT(c1.name) AS domainControllers MATCH (u1)-[:Owns]->(c2:Computer) WHERE c2.name IN domainControllers RETURN  c2.name as DC, u1.name as Owner, head(labels(u1)) as Type, u1.enabled as Enabled ORDER BY DC, Owner"]
["Domain Controller Owned by Users", "HTMLCSV", "DCOwners-Users", "MATCH (c1:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' WITH COLLECT(c1.name) AS domainControllers MATCH (u1:User)-[:Owns]->(c2:Computer) WHERE c2.name IN domainControllers RETURN c2.name as DC, u1.name as Owner, u1.displayname as Name, u1.description as Description,  u1.enabled as Enabled ORDER BY DC, Owner"]
["Unconstrained Delegation Users with SPN","HTMLCSV","Users_UnconstrainedDelegation","MATCH (c:User {unconstraineddelegation:true}) return c.name as User, c.description as Description, c.serviceprincipalnames as SPN"]
["Unconstrained Delegation Computers with SPN","HTMLCSV","Computers_UnconstrainedDelegation","MATCH (c:Computer {unconstraineddelegation:true}) return c.name as Computer, c.description as Description, c.serviceprincipalnames as SPN"]
["Unconstrained Delegation Computers with SPN Non-DC","HTMLCSV","Computers_UnconstrainedDelegationNonDC","MATCH (c1:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' WITH COLLECT(c1.name) AS domainControllers MATCH (c2:Computer {unconstraineddelegation:true}) WHERE NOT c2.name IN domainControllers RETURN c2.name as Computer, c2.description as Description, c2.operatingsystem as OS, c2.serviceprincipalnames as SPN ORDER BY c2.name ASC"]
["Constrained Delegation - All", "HTMLCSV", "ConstrainedDelegation-All", "MATCH (a)-[:AllowedToDelegate]->(b) RETURN a.name as Object, a.enabled as Enabled, head(labels(a)) as Type, b.name as Target, head(labels(b)) as TargetType" ]
["Constrained Delegation - Users", "HTMLCSV", "ConstrainedDelegation-Users", "MATCH (a:User)-[:AllowedToDelegate]->(c:Computer) RETURN a.name as User, a.enabled as Enabled, c.name as TargetComputer" ]
["Constrained Delegation - Users NonDA","HTMLCSV","ConstrainedDelegation-UsersNonDA","MATCH (u1:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-512' WITH COLLECT(u1.name) AS DAs MATCH (a:User)-[:AllowedToDelegate]->(c:Computer) WHERE NOT a.name IN DAs RETURN a.name as User, a.enabled as Enabled, c.name as TargetComputer"]
["Constrained Delegation - Computers NonDC", "HTMLCSV", "ConstrainedDelegation-ComputersNonDC", "MATCH (c1:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' WITH COLLECT(c1.name) AS domainControllers MATCH (c2:Computer {unconstraineddelegation:true}) WHERE NOT c2.name IN domainControllers RETURN c2.name as Computer, c2.description as Description, c2.enabled as Enabled, c2.operatingsystem as OS, c2.serviceprincipalnames as SPN ORDER BY c2.name ASC" ]
["DCSync Direct Relationships","HTMLCSV","DCSyncDirect","MATCH (u)-[:DCSync]->(d:Domain) RETURN d.name AS Domain, u.name as Object, u.enabled as Enabled, head(labels(u)) as type ORDER BY Domain, Object"]
["DCSync Privileged Non-DCs","HTMLCSV","DCSyncDirectNonDCComputers","MATCH (c1:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' WITH COLLECT(c1.name) AS domainControllers MATCH (c2:Computer)-[:DCSync]->(d:Domain) WHERE NOT c2.name IN domainControllers RETURN d.name AS Domain, c2.name as Computer, c2.enabled as Enabled ORDER BY Domain, Computer"]
["DCSync Privileged Non-DAs", "HTMLCSV", "DCSyncDirectNonDAUsers", "MATCH (u1:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-512' WITH COLLECT(u1.name) AS DAs MATCH (u2:User)-[:DCSync]->(d:Domain) WHERE NOT u2.name IN DAs RETURN d.name AS Domain, u2.name as User, u2.displayname as Name, u2.description as Description, u2.enabled as Enabled ORDER BY Domain, User" ]
["Users (Non-Admin) With AddMember Group Permissions ", "HTMLCSV", "UsersnonadminAddMemberGroups", "MATCH(u:User)-[r:AddMember]->(g:Group) WHERE u.admincount = FALSE RETURN u.name as User, g.name as Group" ]
["Direct Relationships - Everyone", "HTML","Relationships-Everyone.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH 'S-1-1-0'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Authenticated Users", "HTML","Relationships-AuthenticatedUsers.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH 'S-1-5-11'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Pre-Windows 2000 Compatibility Access", "HTML","Relationships-PreW2KCA.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH 'S-1-5-32-554'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Domain Users", "HTML","Relationships-DomainUsers.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH '-513'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Domain Computers", "HTML","Relationships-DomainComputers.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH '-515'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Users", "HTML","Relationships-Users.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH '-545'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["Direct Relationships - Guests", "HTML","Relationships-Guests.html", "MATCH p = (g:Group)-[r]->(n) WHERE r.isacl=true AND  g.objectid ENDS WITH '-546'  RETURN g.name as Subject, type(r) as Relationship, n.name as Target, n.enabled as Enabled, n.unconstraineddelegation as UncDelegation, n.haslaps as LAPS, n.trustedtoauth as TrustedToAuth"]
["PasswordResetter Groups Count", "HTML", "Groups_CanResetPasswordsCount.html", "MATCH p=(m:Group)-[r:ForceChangePassword]->(n:User) RETURN m.name as Group, m.distinguishedname as DN, count(*) as Users ORDER BY Users DESC"]
["GPOs", "HTMLCSV", "GPOs", "Match (n:GPO) return n.name as GPO, n.highvalue as HighValue, n.gpcpath as Path" ]
["GPO OU Links", "HTMLCSV", "GPO_OU_Links", "MATCH (u:GPO)-[:GPLink]->(g) RETURN g.distinguishedname AS OU, u.name as GPO ORDER BY OU, GPO" ]
["GPO Owners Summary Count","HTMLCSV","GPOOwners-Summary","MATCH (u)-[:Owns]->(g:GPO) RETURN u.name as Owner, u.enabled as Enabled, head(labels(u)) as Type,  count(g.name) AS GPOs ORDER BY GPOs DESC, Owner"]
["GPO Owners Detail","HTMLCSV","GPOOwners-Detail","MATCH (u)-[:Owns]->(g:GPO) RETURN u.name as Owner, u.enabled as Enabled, head(labels(u)) as Type, g.name AS GPO ORDER BY GPO, Owner"]
["GPO Owners - Non-(Direct)DAs", "HTMLCSV", "GPOOwners-NonDA", "MATCH (u1:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-512' WITH COLLECT(u1.name) AS DAs MATCH (u2:User)-[:Owns]->(gp:GPO) WHERE NOT u2.name IN DAs  RETURN gp.name AS GPO, u2.name as Owner, u2.enabled as Enabled ORDER BY GPO, Owner" ]
["GPOS - Non-(Direct)DA Users With Interesting GPO Permissions", "HTMLCSV", "GPOs-NonDA-WithInterestingPermissions", "MATCH (u1:User)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-512' WITH COLLECT(u1.name) AS DAs MATCH (u2:User)-[r:AllExtendedRights|GenericAll|GenericWrite|Owns|WriteDacl|WriteOwner]->(g:GPO) WHERE NOT u2.name in DAs RETURN u2.name as User, type(r) as Relationship, g.name as GPO" ]
["GPO Creator Owners (Direct)", "HTML", "GPOCreatorOwners.html", "MATCH p=(n:Group)<-[:MemberOf]-(m) WHERE n.objectid =~ '(?i)S-1-5-.*-520' RETURN m.name as Name, m.displayname as DisplayName,m.description as Description, m.enabled as Enabled, m.pwdneverexpires as PWDNeverExpire, m.trustedtoauth as TrustedToAuth, m.unconstraineddelegation as UncDelegation " ]
["RDPable Groups", "HTML", "RDPableGroups.html", "MATCH p=(m:Group)-[r:CanRDP]->(n:Computer) RETURN m.name as Group, n.name as Computer ORDER BY m.name" ]
["RDPable Groups Count", "HTML", "RDPableGroupsCount.html", "MATCH p=(m:Group)-[r:CanRDP]->(n:Computer) RETURN m.name as Group, count(*) as Computer ORDER BY Computer DESC" ]
["Computers Vulnerable to Local Admin Enumeration","HTMLCSV","Computers_LocalAdminEnumeration","MATCH p=()-[:AdminTo]->(n:Computer) RETURN  distinct(n.name) as Host, n.operatingsystem as OS"]
["Local Admins - Groups", "HTML", "LocalAdmin_Groups.html", "MATCH p=(m:Group)-[r:AdminTo]->(n:Computer) RETURN m.name as Group, n.name as Computer ORDER BY m.name" ]
["Local Admins - Groups Count", "HTML", "LocalAdmin_Groups_Count.html", "MATCH p=(m:Group)-[r:AdminTo]->(n:Computer) RETURN m.name as Group, count(*) as Computer ORDER BY Computer DESC"]
["Local Admins - Users","HTML","LocalAdmin_Users.html","MATCH p=(m:User)-[r:AdminTo]->(n:Computer) RETURN m.name as User, n.name as Computer ORDER BY m.name"]
["Local Admins - Users Count","HTML","LocalAdmin_UsersCount.html","MATCH p=(m:User)-[r:AdminTo]->(n:Computer) RETURN m.name as User, count(*) as ComputerCount ORDER BY ComputerCount DESC" ]
["Local Admins - Computers","HTMLCSV","LocalAdmin_Computers_","MATCH p=(m:Computer {enabled: True})-[r1:MemberOf*0..]->(g)-[r2:AdminTo*1..]->(n:Computer) WHERE n <> m RETURN m.name as Computer, n.name as TargetComputer"]
["Local Admins - Computers Count","HTML","LocalAdmins_Computers_count.html","MATCH p=(m:Computer {enabled: True})-[r1:MemberOf*0..]->(g)-[r2:AdminTo*1..]->(n:Computer) WHERE n <> m RETURN m.name as Computer, COUNT(n) as TargetComputerCount"]
["Computers with MSSQL SPN","HTMLCSV","Computers_MSSQL","MATCH (c:Computer) WHERE ANY (x IN c.serviceprincipalnames WHERE toUpper(x) CONTAINS 'MSSQL') RETURN c.name as Computer, c.enabled as Enabled, c.serviceprincipalnames as SPN ORDER BY c.name ASC"]
["Computers with Descriptions","HTMLCSV","Computers_WithDescriptions","MATCH (c:Computer) WHERE c.description IS NOT NULL RETURN c.name as Computer,c.description as Description"]
["Operating Systems Unsupported", "HTMLCSV", "OS_Unsupported", "MATCH (c:Computer) WHERE c.operatingsystem =~ '.*(2000|2003|2008|2012|xp|vista|7|me).*' RETURN c.name as Computer, c.operatingsystem as UnsupportedOS, c.enabled as Enabled, toString(datetime({epochSeconds: ToInteger(coalesce(c.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(c.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Operating Systems Unsupported Count", "HTMLCSV", "OS_Unsupported_Count", "MATCH (c:Computer) WHERE c.operatingsystem =~ '.*(2000|2003|2008|2012|xp|vista|7|me).*' RETURN COUNT(DISTINCT(c.name)) as Computers, c.operatingsystem as UnsupportedOS, c.enabled as Enabled ORDER BY Enabled DESC, Computers DESC" ]
["Operating Systems Count", "HTMLCSV", "OS_Count", "MATCH (c:Computer) RETURN c.operatingsystem aS OS, count(*) as Computers, c.enabled as Enabled ORDER BY Enabled DESC, Computers DESC" ]
["LAPS Deployment Count","HTMLCSV","LapsDeploymentCount","MATCH (c:Computer) RETURN c.haslaps as LAPSEnabled, count(*) as Computers ORDER BY Computers DESC"]
["LAPS Deployment OS Count","HTMLCSV","LapsDeploymentCount-OS","MATCH (c:Computer) RETURN c.haslaps as LAPSEnabled, c.operatingsystem as OS, count(*) as Computers ORDER BY LAPSEnabled DESC, Computers DESC"]
["LAPS Not Enabled", "HTML", "LAPSNotEnabled.html", "MATCH (c:Computer) WHERE c.haslaps=false RETURN c.name as Computer, c.enabled as ObjectEnabled, c.operatingsystem as OS, c.description as Descirption, ToString(datetime({epochSeconds: ToInteger(coalesce(c.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(c.lastlogontimestamp,0))})) as LastLogonTimeStamp Order By Computer"]
["GMSA Read Permissions - Direct", "HTMLCSV", "GMSA_CanReadPassword", "match (g)-[r:ReadGMSAPassword]->(u) Return g.name as Object, head(labels(g)) as Type,  u.name as Target" ]
["Users Sessions", "HTMLCSV", "Users_Sessions", "MATCH p=(n:User)--(c:Computer)-[:HasSession]->(n) return n.name as User,  c.name as Computer ORDER BY n.name"]
["Users Sessions Count", "HTML", "Users_Sessions_Count.html", "MATCH p=(n:User)--(c:Computer)-[:HasSession]->(n) return n.name as User, count(*) as Computers ORDER BY Computers DESC"]
["Users With < 1 Day Old Passwords", "HTMLCSV", "Users_le01DOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) < 86400 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With < 7 Day Old Passwords", "HTMLCSV", "Users_lt07DOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) < 604800 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With < 30 Day Old Passwords", "HTMLCSV", "Users_lt30DOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) < 2592000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 6 Month Old Passwords", "HTMLCSV", "Users_gt006MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 15552000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 1 Year Old Passwords", "HTMLCSV", "Users_gt012MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 31104000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 5 Year Old Passwords", "HTMLCSV", "Users_gt060MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 157680000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 10 Year Old Passwords", "HTMLCSV", "Users_gt120MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 315360000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 15 Year Old Passwords", "HTMLCSV", "Users_gt180MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 473040000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users With > 20 Year Old Passwords", "HTMLCSV", "Users_gt240MoOldPasswords", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.pwdlastset) > 630720000 AND n.pwdlastset<>-1.0  AND n.pwdlastset<>0.0 RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.enabled as Enabled, n.admincount as AdminCount, n.pwdneverexpires as PassNeverExpire, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp ORDER BY n.pwdlastset" ]
["Users Password Never Expires Exception", "HTMLCSV", "Users_NeverExpirePasswords", "MATCH (n:User) WHERE n.pwdneverexpires RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Users Password Not Required", "HTML", "Users_PasswordNotRequired.html", "MATCH (n:User) where n.passwordnotreqd = True RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Users Password Not Required and Never Set", "HTML", "Users_PasswordNotRequiredNeverSet.html", "MATCH (n:User) where n.passwordnotreqd = True and n.pwdlastset<1 RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Users With Userpassword Attribute", "HTMLCSV", "Users_userpassword", "MATCH (u:User) WHERE NOT u.userpassword IS null RETURN u.name as User, u.userpassword as Password, u.enabled as Enabled"]
["User No Kerb Needed (AS-REP Roastable Users)","HTMLCSV","Users_NoKerbReq","MATCH (n:User {dontreqpreauth: true}) RETURN n.name as Username, n.displayname as DisplayName, n.description as Description, n.title as Title, n.pwdneverexpires as PasswordNeverExpires, n.passwordnotreqd as PasswordNotRequired, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPNs"]
["Users Not Active 6 Months", "HTMLCSV", "UsersNotActive6mo", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.lastlogontimestamp) > 15552000 AND n.lastlogontimestamp<>-1.0 RETURN n.name as Username, n.displayname as DisplayName, n.enabled as Enabled, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogon ORDER BY LastLogon" ]
["Users Not Active 12 Months", "HTMLCSV", "UsersNotActive12mo", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.lastlogontimestamp) > 31104000 AND n.lastlogontimestamp<>-1.0 RETURN n.name as Username, n.displayname as DisplayName, n.enabled as Enabled, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogon ORDER BY LastLogon" ]
["Users Not Active 60 Months", "HTMLCSV", "UsersNotActive60mo", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.lastlogontimestamp) > 155520000 AND n.lastlogontimestamp<>-1.0 RETURN n.name as Username, n.displayname as DisplayName, n.enabled as Enabled, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogon ORDER BY LastLogon" ]
["Users Not Active 120 Months", "HTMLCSV", "UsersNotActive120mo", "WITH timestamp() / 1000 AS date_now MATCH (n:User) WHERE date_now - toInteger(n.lastlogontimestamp) > 311040000 AND n.lastlogontimestamp<>-1.0 RETURN n.name as Username, n.displayname as DisplayName, n.enabled as Enabled, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogon ORDER BY LastLogon" ]
["Users Never Active","HTMLCSV","Users_NeverActive_Enabled","MATCH (n:User) WHERE n.lastlogontimestamp=-1.0 AND n.enabled=TRUE RETURN n.name as Username ORDER BY n.name"]
["Hunt - Users with Pass or PW in Description", "HTML", "HuntUsersWithPassInDescription.html", "MATCH (n:User) WHERE n.description  =~ '(?i).*(pass|pw).*' RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Hunt - Users with Change in Description", "HTML", "HuntUsersWithChangeInDescription.html", "MATCH (n:User) WHERE n.description  =~ '(?i).*(change).*' RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["Hunt - Users with VPN Group", "HTML", "HuntUsersWithVPNGroup.html", "Match (u:User)-[:MemberOf]->(g:Group) WHERE toUPPER (g.name) CONTAINS 'VPN' return u.name as User, g.name as Group" ]
["Hunt - Computers with Pass or PW in Description", "HTML", "HuntComputersWithPassInDescription.html", "MATCH (n:Computer) WHERE n.description =~ '(?i).*(pass|pw).*' RETURN n.name as Name, n.domain, n.enabled as Enabled,n.haslaps as LAPS, n.highvalue as HighValue,n.operatingsystem as OS,  n.description as Description, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp, n.serviceprincipalnames as SPN ORDER BY n.highvalue DESC , n.name ASC" ]
["BH-Legacy: Owned Groups","HTML","Owned-Groups.html","Match (n:Group) where n.owned=TRUE return n.name as Name, n.highvalue as HighValue, n.description as Description"]
["BH-Legacy: Owned Users", "HTML", "Owned-Users.html", "MATCH (n:User) WHERE n.owned=TRUE RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["BH-Legacy: Owned Computers", "HTML", "Owned-Computers.html", "MATCH (n:Computer) where n.owned=TRUE RETURN n.name as Name, n.domain, n.enabled as Enabled,n.haslaps as LAPS, n.highvalue as HighValue,n.operatingsystem as OS,  n.description as Description, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp,n.serviceprincipalnames as SPN ORDER BY n.highvalue DESC , n.name ASC" ]
["BH-Legacy: Owned Users Group Membership", "HTML", "Owned-Users-Groups.html", "MATCH (m:User) WHERE m.owned=TRUE WITH m MATCH p=(m)-[:MemberOf*1..]->(n:Group) RETURN m.name as User, n.name as Group, n.description as Description ORDER BY m.name" ]
["BH-Legacy: Owned Computers Group Membership", "HTML", "Owned-Computers-Groups.html", "MATCH (m:Computer) WHERE m.owned=TRUE WITH m MATCH p=(m)-[:MemberOf*1..]->(n:Group) RETURN m.name as Computer, n.name as Group, n.description as Description ORDER BY m.name" ]
["BH-Legacy: Owned Users Group Membership (Direct Distinct)", "HTML", "Owned-Users-Groups-DirectDistinct.html", "MATCH (m:User) WHERE m.owned=TRUE WITH m MATCH p=(m)-[:MemberOf]->(n:Group) RETURN Distinct n.name as Group, n.description as Description ORDER BY n.name" ]
["BH-Legacy: Owned Computers Group Membership (Direct Distinct)", "HTML", "Owned-Computers-Groups-DirectDistinct.html", "MATCH (m:Computer) WHERE m.owned=TRUE WITH m MATCH p=(m)-[:MemberOf]->(n:Group) RETURN Distinct  n.name as Group, n.description as Description ORDER BY n.name" ]
["BH-Legacy: Owned Users Interesting Relationships", "HTLMCSV", "Owned-Users-Interesting-Relationships", "MATCH (m:User) WHERE m.owned=TRUE WITH m MATCH p=(m)-[r]->(n) where not (type(r)='MemberOf') RETURN m.name as User, type(r) as Relationship, n.name as Target, head(Labels(n)) as TargetType,  n.description as Description ORDER BY n.name" ]
["BH-Legacy: Owned Computers Interesting Relationships", "HTLMCSV", "Owned-Computers-Interesting-Relationships", "MATCH (m:computer) WHERE m.owned=TRUE WITH m MATCH p=(m)-[r]->(n) where not (type(r)='MemberOf') RETURN m.name as Computer, type(r) as Relationship, n.name as Target, head(Labels(n)) as TargetType,  n.description as Description ORDER BY n.name" ]
["BH-Legacy: Owned Objects", "HTML", "Owned-Objects.html", "MATCH (n {owned:true}) return n.name as Name, n.highvalue as HighValue, n.enabled as Enabled, n.trustedtoauth as TrustedToAuth, n.unconstraineddelegation as UncDelegation, n.serviceprincipalnames as SPN"]
["BH-Legacy: Owned Objects Admin To", "HTML", "Owned-Objects-AdminTo-Direct.html", "MATCH (n {owned:true})-[r:AdminTo]->(c) return n.name as OwnedObject,c.name as Target, c.highvalue as HighValue, head(Labels(c)) as Type, c.enabled as ComputerEnabled, c.description as Description" ]
["BH-Legacy: Owned Objects Member Of (Direct)", "HTML", "Owned-Objects-MemberOf-Direct.html", "MATCH (n {owned:true})-[r:MemberOf]->(g:Group) return n.name as Name, n.highvalue as HighValue, n.enabled as Enabled, g.name as GroupName, g.description as GroupDescription"]
["BH-Legacy: Owned Objects Read GMSA Password - Recursive", "HTML", "Owned-Objects-GMSARead-Direct.html", "MATCH (m)-[r:MemberOf*1..]->(g) Where m.owned=true WITH g,m MATCH p=(g)-[:ReadGMSAPassword]->(u) RETURN Distinct m.name as User, g.name as GMSAGroup, u.name as Target, u.description as Description ORDER BY u.name"]
["BH-CE: Owned Groups","HTML","Owned-Groups(BH-CE).html","Match (n:Group:Tag_Owned) return n.name as Name, n.highvalue as HighValue, n.description as Description"]
["BH-CE: Owned Users", "HTML", "Owned-Users(BH-CE).html", "MATCH (n:User:Tag_Owned) RETURN n.name as Name,n.displayname as DisplayName,n.enabled as Enabled, n.highvalue as HighValue,  n.description as Description, n.title as Title, n.pwdneverexpires as PWDNeverExpires, n.passwordnotreqd as PWDNotReqd, n.sensitive as Sensitive, n.admincount as AdminCount, n.serviceprincipalnames as SPN, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp" ]
["BH-CE: Owned Computers", "HTML", "Owned-Computers(BH-CE).html", "MATCH (n:Computer:Tag_Owned) RETURN n.name as Name, n.domain, n.enabled as Enabled,n.haslaps as LAPS, n.highvalue as HighValue,n.operatingsystem as OS,  n.description as Description, toString(datetime({epochSeconds: ToInteger(coalesce(n.pwdlastset,0))})) as PWDLastSet, toString(datetime({epochSeconds: ToInteger(coalesce(n.lastlogontimestamp,0))})) as LastLogonTimeStamp,n.serviceprincipalnames as SPN ORDER BY n.highvalue DESC , n.name ASC" ]
["BH-CE: Owned Users Group Membership", "HTML", "Owned-Users-Groups(BH-CE).html", "MATCH (m:User:Tag_Owned) WITH m MATCH p=(m)-[:MemberOf*1..]->(n:Group) RETURN m.name as User, n.name as Group, n.description as Description ORDER BY m.name" ]
["BH-CE: Owned Computers Group Membership", "HTML", "Owned-Computers-Groups(BH-CE).html", "MATCH (m:Computer:Tag_Owned) WITH m MATCH p=(m)-[:MemberOf*1..]->(n:Group) RETURN m.name as Computer, n.name as Group, n.description as Description ORDER BY m.name" ]
["BH-CE: Owned Users Group Membership (Direct Distinct)", "HTML", "Owned-Users-Groups-DirectDistinct(BH-CE).html", "MATCH (m:User:Tag_Owned) WITH m MATCH p=(m)-[:MemberOf]->(n:Group) RETURN Distinct n.name as Group, n.description as Description ORDER BY n.name" ]
["BH-CE: Owned Computers Group Membership (Direct Distinct)", "HTML", "Owned-Computers-Groups-DirectDistinct(BH-CE).html", "MATCH (m:Computer:Tag_Owned) WITH m MATCH p=(m)-[:MemberOf]->(n:Group) RETURN Distinct  n.name as Group, n.description as Description ORDER BY n.name" ]
["BH-CE: Owned Users Interesting Relationships", "HTLMCSV", "Owned-Users-Interesting-Relationships(BH-CE)", "MATCH (m:User:Tag_Owned) WITH m MATCH p=(m)-[r]->(n) where not (type(r)='MemberOf') RETURN m.name as User, type(r) as Relationship, n.name as Target, head(Labels(n)) as TargetType,  n.description as Description ORDER BY n.name" ]
["BH-CE: Owned Computers Interesting Relationships", "HTLMCSV", "Owned-Computers-Interesting-Relationships(BH-CE)", "MATCH (m:computer:Tag_Owned) WITH m MATCH p=(m)-[r]->(n) where not (type(r)='MemberOf') RETURN m.name as Computer, type(r) as Relationship, n.name as Target, head(Labels(n)) as TargetType,  n.description as Description ORDER BY n.name" ]
["BH-CE: Owned Objects", "HTML", "Owned-Objects(BH-CE).html", "MATCH (n:Tag_Owned) return n.name as Name, n.highvalue as HighValue, n.enabled as Enabled, n.trustedtoauth as TrustedToAuth, n.unconstraineddelegation as UncDelegation, n.serviceprincipalnames as SPN" ]
["BH-CE: Owned Objects Admin To", "HTML", "Owned-Objects-AdminTo-Direct(BH-CE).html", "MATCH (n:Tag_Owned)-[r:AdminTo]->(c) return n.name as OwnedObject,c.name as Target, c.highvalue as HighValue, head(Labels(c)) as Type, c.enabled as ComputerEnabled, c.description as Description" ]
["BH-CE: Owned Objects Member Of (Direct)", "HTML", "Owned-Objects-MemberOf-Direct(BH-CE).html", "MATCH (n:Tag_Owned)-[r:MemberOf]->(g:Group) return n.name as Name, n.highvalue as HighValue, n.enabled as Enabled, g.name as GroupName, g.description as GroupDescription" ]
["BH-CE: Owned Objects Read GMSA Password - Recursive", "HTML", "Owned-Objects-GMSARead-Direct(BH-CE).html", "MATCH (m:Tag_Owned)-[r:MemberOf*1..]->(g) WITH g,m MATCH p=(g)-[:ReadGMSAPassword]->(u) RETURN Distinct m.name as User, g.name as GMSAGroup, u.name as Target, u.description as Description ORDER BY u.name" ]
["BH-CE:Owned Objects ADCS Privilges", "HTMLCSV","ADCS_Owned-Ojects-Privs", "MATCH (owned:Tag_Owned) WHERE owned:User OR owned:Computer MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA) WHERE principal.objectid = owned.objectid OR EXISTS { MATCH (owned)-[:MemberOf*1..]->(principal) } OR (principal.name STARTS WITH 'AUTHENTICATED USERS@' AND (owned:User OR owned:Computer)) OR (principal.name STARTS WITH 'EVERYONE@' AND (owned:User OR owned:Computer)) OR (principal.name STARTS WITH 'DOMAIN USERS@' AND owned:User AND split(principal.name, '@')[1] = split(owned.name, '@')[1]) OR (principal.name STARTS WITH 'DOMAIN COMPUTERS@' AND owned:Computer AND split(principal.name, '@')[1] = split(owned.name, '@')[1]) RETURN DISTINCT owned.name AS OwnedPrincipal, ct.name AS CertificateTemplate, ca.name AS CertificateAuthority, principal.name AS EnrollmentVia, type(r) AS EnrollmentPermission, ct.authenticationenabled AS AuthenticationEnabled, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures ORDER BY OwnedPrincipal, CertificateTemplate, CertificateAuthority LIMIT 1000" ]
[ "ADCS Certificate Authorities", "HTMLCSV", "ADCS_CertificateAuthorties", "MATCH (ca:EnterpriseCA) OPTIONAL MATCH (ct:CertTemplate)-[:PublishedTo]->(ca) WITH ca, collect(DISTINCT ct.name) AS PublishedTemplates RETURN ca.name AS CertificateAuthority, ca.domain AS Domain, ca.caname AS CAName, ca.dnshostname AS DNSHostname, ca.hasvulnerableendpoint AS VulnerableEndpoint, ca.isuserspecifiessanenabled AS UserSpecifiedSANEnabled, ca.webclientrunning AS WebEnrollmentEnabled, ca.unresolvedpublishedtemplates AS UnresolvedTemplates, size(PublishedTemplates) AS PublishedTemplateCount, PublishedTemplates ORDER BY CertificateAuthority LIMIT 1000" ]
[ "ADCS Certificate Authorities Permissions", "HTMLCSV", "ADCS_CA_Permissions", "MATCH (ca:EnterpriseCA) OPTIONAL MATCH (principal:Base)-[r:ManageCA|ManageCertificates|Enroll|GenericAll|GenericWrite|WriteDacl|WriteOwner|Owns|AllExtendedRights]->(ca) RETURN ca.name AS CertificateAuthority, principal.name AS Principal, labels(principal) AS PrincipalType, type(r) AS Permission ORDER BY CertificateAuthority, Principal, Permission LIMIT 1000" ]
[ "ADCS Certificate Authorities Permissions - Non-Tier-Zero Permissions", "HTMLCSV", "ADCS_CA_Permissions_NonTierZero", "MATCH (ca:EnterpriseCA) OPTIONAL MATCH (principal:Base)-[r:ManageCA|ManageCertificates|Enroll|GenericAll|GenericWrite|WriteDacl|WriteOwner|Owns|AllExtendedRights]->(ca) WHERE NOT 'Tag_Tier_Zero' IN labels(principal) RETURN ca.name AS CertificateAuthority, principal.name AS Principal, labels(principal) AS PrincipalType, type(r) AS Permission ORDER BY CertificateAuthority, Principal, Permission LIMIT 1000" ]
[ "ADCS Certificate Templates", "HTMLCSV", "ADCS_CertificateTemplates", "MATCH (ct:CertTemplate) OPTIONAL MATCH (ct)-[:PublishedTo]->(ca:EnterpriseCA) WITH ct, collect(DISTINCT ca.name) AS CertificateAuthorities OPTIONAL MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights|GenericWrite|WriteDacl|WriteOwner|Owns]->(ct) WITH ct, CertificateAuthorities, collect(DISTINCT CASE WHEN principal IS NOT NULL THEN principal.name + ' (' + type(r) + ')' END) AS PrincipalPermissions RETURN ct.name AS CertificateTemplate, ct.schemaversion AS SchemaVersion, ct.authenticationenabled AS AuthenticationEnabled, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures, ct.effectiveekus AS EffectiveEKUs, ct.validityperiod AS ValidityPeriod, ct.renewalperiod AS RenewalPeriod, ct.requireskeyarchival AS RequiresKeyArchival, ct.nosecurityextension AS NoSecurityExtension, ct.subjectaltrequireupn AS SubjectAltRequireUPN, ct.subjectaltrequiredns AS SubjectAltRequireDNS, size(CertificateAuthorities) AS PublishingCACount, CertificateAuthorities, PrincipalPermissions ORDER BY CertificateTemplate LIMIT 1000 " ]
[ "ADCS Certificate Template Permissions", "HTMLCSV", "ADCS_Template_Permissions", "MATCH (ct:CertTemplate) OPTIONAL MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights|GenericWrite|WriteDacl|WriteOwner|Owns]->(ct) RETURN ct.name AS Template, principal.name AS Principal, type(r) AS Permission ORDER BY Template, Principal, Permission LIMIT 5000" ]
[ "ADCS Certificate Template Non-Tier-Zero Permissions", "HTMLCSV", "ADCS_Template_Permissions_NonTierZero", "MATCH (ct:CertTemplate) OPTIONAL MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights|GenericWrite|WriteDacl|WriteOwner|Owns]->(ct) WHERE NOT 'Tag_Tier_Zero' IN labels(principal) RETURN ct.name AS Template, ct.distinguishedname AS DistinguishedName, ct.objectid AS ObjectID, principal.name AS Principal, labels(principal) AS PrincipalType, type(r) AS Permission ORDER BY Template, Principal, Permission LIMIT 1000 " ]
[ "ADCS Certificate Enrollment Rights", "HTMLCSV", "ADCS_CertificateTemplateEnrollRights", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA)  RETURN DISTINCT ct.name AS CertificateTemplate, ca.name AS CertificateAuthority, principal.name AS Principal, type(r) AS EnrollmentPermission ORDER BY CertificateTemplate, CertificateAuthority, Principal, EnrollmentPermission LIMIT 1000" ]
[ "ADCS ESC1", "HTMLCSV", "ADCS_ESC1", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA) WHERE ct.enrolleesuppliessubject = true AND ct.authenticationenabled = true AND ct.requiresmanagerapproval = false AND (ct.authorizedsignatures = 0 OR ct.schemaversion = 1) WITH ct, collect(DISTINCT ca.name) AS CertificateAuthorities, collect(DISTINCT principal.name) AS EnrollablePrincipals, collect(DISTINCT type(r)) AS Permissions RETURN ct.name AS Template, CertificateAuthorities, EnrollablePrincipals, Permissions, ct.schemaversion AS SchemaVersion, ct.authorizedsignatures AS AuthorizedSignatures, ct.validityperiod AS ValidityPeriod, ct.renewalperiod AS RenewalPeriod ORDER BY Template LIMIT 1000" ]
[ "ADCS ESC2", "HTMLCSV", "ADCS_ESC2", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA) WHERE ct.requiresmanagerapproval = false AND (ct.effectiveekus = [''] OR '2.5.29.37.0' IN ct.effectiveekus OR ct.effectiveekus IS NULL) AND (ct.authorizedsignatures = 0 OR ct.schemaversion = 1) WITH ct, collect(DISTINCT ca.name) AS CertificateAuthorities, collect(DISTINCT principal.name) AS EnrollablePrincipals, collect(DISTINCT type(r)) AS Permissions RETURN ct.name AS Template, CertificateAuthorities, EnrollablePrincipals, Permissions, ct.effectiveekus AS EffectiveEKUs, ct.schemaversion AS SchemaVersion, ct.authorizedsignatures AS AuthorizedSignatures, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.validityperiod AS ValidityPeriod, ct.renewalperiod AS RenewalPeriod ORDER BY Template LIMIT 1000" ]
[ "ADCS ESC3", "HTMLCSV", "ADCS_ESC3", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA) WHERE NOT 'Tag_Tier_Zero' IN labels(principal) AND '1.3.6.1.4.1.311.20.2.1' IN ct.effectiveekus AND ct.requiresmanagerapproval = false AND (ct.authorizedsignatures = 0 OR ct.schemaversion = 1) RETURN DISTINCT ct.name AS CertificateTemplate, ca.name AS CertificateAuthority, principal.name AS Principal, labels(principal) AS PrincipalType, type(r) AS EnrollmentPermission, ct.effectiveekus AS EffectiveEKUs, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures, ct.schemaversion AS SchemaVersion ORDER BY CertificateTemplate, CertificateAuthority, Principal LIMIT 1000" ]
[ "ADCS ESC4", "HTMLCSV", "ADCS_ESC4", "MATCH (principal:Base)-[r:GenericAll|GenericWrite|WriteDacl|WriteOwner|Owns]->(ct:CertTemplate) OPTIONAL MATCH (ct)-[:PublishedTo]->(ca:EnterpriseCA) WHERE NOT 'Tag_Tier_Zero' IN labels(principal) RETURN DISTINCT ct.name AS CertificateTemplate, ca.name AS CertificateAuthority, principal.name AS Principal, type(r) AS Permission, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.authenticationenabled AS AuthenticationEnabled, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures ORDER BY CertificateTemplate, CertificateAuthority, Principal, Permission LIMIT 1000" ]
[ "ADCS ESC5", "HTMLCSV", "ADCS_ESC5", "MATCH (principal:Base)-[r:Owns|WriteOwner|WriteDacl|GenericAll|GenericWrite]->(target:Base) WHERE (toUpper(coalesce(target.distinguishedname, '')) CONTAINS 'PUBLIC KEY SERVICES' OR target:EnterpriseCA OR target:RootCA OR target:NTAuthStore OR target:AIAContainer) AND NOT 'Tag_Tier_Zero' IN labels(principal) AND NOT principal.objectid ENDS WITH '-512' AND NOT principal.objectid ENDS WITH '-519' AND NOT principal.objectid ENDS WITH '-544' RETURN DISTINCT target.name AS TargetObject, labels(target) AS TargetType, principal.name AS Principal, labels(principal) AS PrincipalType, type(r) AS Permission, target.objectid AS ObjectID ORDER BY TargetObject, Principal, Permission LIMIT 5000" ]
[ "ADCS ESC6", "HTMLCSV", "ADCS_ESC6", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(eca:EnterpriseCA) WHERE eca.isuserspecifiessanenabled = true WITH ct, collect(DISTINCT eca.name) AS CertificateAuthorities, collect(DISTINCT principal.name) AS EnrollablePrincipals, collect(DISTINCT type(r)) AS Permissions RETURN ct.name AS Template, CertificateAuthorities, EnrollablePrincipals, Permissions, ct.authenticationenabled AS AuthenticationEnabled, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures, ct.schemaversion AS SchemaVersion, ct.effectiveekus AS EffectiveEKUs, ct.validityperiod AS ValidityPeriod, ct.renewalperiod AS RenewalPeriod ORDER BY Template LIMIT 1000" ]
[ "ADCS ESC7", "HTMLCSV", "ADCS_ESC7", "MATCH (principal:Base)-[r:ManageCertificates|ManageCA]->(eca:EnterpriseCA) WITH eca, collect(DISTINCT principal.name) AS Principals, collect(DISTINCT type(r)) AS Permissions RETURN eca.name AS CertificateAuthority, eca.distinguishedname AS DistinguishedName, eca.objectid AS ObjectID, Principals, Permissions ORDER BY CertificateAuthority LIMIT 1000" ]
[ "ADCS ESC8", "HTMLCSV", "ADCS_ESC8", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(eca:EnterpriseCA) WHERE eca.hasvulnerableendpoint = true WITH ct, collect(DISTINCT eca.name) AS CertificateAuthorities, collect(DISTINCT principal.name) AS EnrollablePrincipals, collect(DISTINCT type(r)) AS Permissions RETURN ct.name AS Template, CertificateAuthorities, EnrollablePrincipals, Permissions, ct.authenticationenabled AS AuthenticationEnabled, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures, ct.schemaversion AS SchemaVersion, ct.effectiveekus AS EffectiveEKUs, ct.validityperiod AS ValidityPeriod, ct.renewalperiod AS RenewalPeriod ORDER BY Template LIMIT 1000" ]
[ "ADCS ESC13", "HTMLCSV", "ADCS_ESC13", "MATCH (s:Base)-[r:GenericAll|GenericWrite|Owns|WriteOwner|WriteDacl]->(ip:IssuancePolicy) WHERE NOT s.objectid ENDS WITH '-512' AND NOT s.objectid ENDS WITH '-519' WITH ip, collect(DISTINCT s.name) AS Principals, collect(DISTINCT type(r)) AS Permissions RETURN ip.name AS IssuancePolicy, ip.distinguishedname AS DistinguishedName, ip.objectid AS ObjectID, Principals, Permissions ORDER BY IssuancePolicy LIMIT 1000" ]
[ "ADCS ESC17", "HTMLCSV", "ADCS_ESC17", "MATCH (principal:Base)-[r:Enroll|GenericAll|AllExtendedRights]->(ct:CertTemplate)-[:PublishedTo]->(ca:EnterpriseCA) WHERE '1.3.6.1.5.5.7.3.1' IN ct.effectiveekus AND ct.requiresmanagerapproval = false AND (ct.authorizedsignatures = 0 OR ct.schemaversion = 1) AND NOT 'Tag_Tier_Zero' IN labels(principal) RETURN DISTINCT ct.name AS CertificateTemplate, ca.name AS CertificateAuthority, principal.name AS Principal, type(r) AS EnrollmentPermission, ct.effectiveekus AS EffectiveEKUs, ct.enrolleesuppliessubject AS EnrolleeSuppliesSubject, ct.authenticationenabled AS AuthenticationEnabled, ct.requiresmanagerapproval AS ManagerApprovalRequired, ct.authorizedsignatures AS AuthorizedSignatures, ct.schemaversion AS SchemaVersion ORDER BY CertificateTemplate, CertificateAuthority, Principal LIMIT 1000"]
